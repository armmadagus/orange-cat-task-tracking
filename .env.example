NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only. Required only for an admin to create login accounts from the
# Members page. Never prefix this variable with NEXT_PUBLIC_ or commit a value.
SUPABASE_SECRET_KEY=

# Optional Playwright credentials. Supply real values only through the process
# environment or an ignored local env file; never commit them.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_PROJECT_ID=
E2E_ALLOW_MUTATIONS=false
